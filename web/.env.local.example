# Crafted 3D Workshop / PrintCue: Next.js app (web/) environment variables
# Copy to .env.local (gitignored) and fill in values. Never commit .env.local.
# Set the same variables in Vercel for deploys.

# --- PUBLIC: exposed to the browser (NEXT_PUBLIC_) ---

# Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key. Public by design.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Default shop slug for /request and /inventory when no ?shop= param is given.
# Not a secret. Must match a real shops.shop_slug.
NEXT_PUBLIC_DEFAULT_SHOP_SLUG=

# --- SERVER-ONLY: never prefix with NEXT_PUBLIC_ ---

# SECRET. Supabase service-role key. Bypasses RLS; every query must filter
# by shop_slug.
SUPABASE_SERVICE_ROLE_KEY=

# SECRET. Signs and verifies the Hub session cookie. Required: Hub login
# fails without it. Use a long random value.
HUB_SESSION_SECRET=

# SECRET. Resend API key for notification and access-request emails.
RESEND_API_KEY=

# Base URL where /hub lives, used for "View Dashboard" links in notifications.
# Not a secret.
HUB_DASHBOARD_URL=